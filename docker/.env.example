# cargo run --example e2e -- init generates docker/.env with fresh keys.
# Base64 of [scheme byte 0 | 32-byte Ed25519 private key]. Testnet only.
GAS_STATION_1_PRIVATE_KEY=
GAS_STATION_2_PRIVATE_KEY=
GAS_STATION_3_PRIVATE_KEY=
GS_AUTH=
IOTA_RPC_URL=https://api.testnet.iota.cafe
IOTA_GRPC_URL=https://grpc.testnet.iota.cafe
# Optional: path relative to docker/ to your gas-station checkout.
GAS_STATION_SOURCE=../../gas-station
