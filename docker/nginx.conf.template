worker_processes 1;
error_log /dev/stderr warn;
pid /var/run/nginx.pid;

events { worker_connections 1024; }

http {
    log_format routing '$status $request_method $uri upstream=$upstream_addr';
    access_log /dev/stdout routing;

    upstream routers {
        server 127.0.0.1:${ROUTER_1_RPC_PORT} max_fails=0;
        server 127.0.0.1:${ROUTER_2_RPC_PORT} max_fails=0;
    }

    server {
        listen 127.0.0.1:${ROUTER_PROXY_PORT};
        client_max_body_size 2m;

        location / {
            proxy_pass http://routers;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_connect_timeout 1s;
            proxy_read_timeout 90s;
            # The router owns POST retry safety; the proxy must never replay one.
            proxy_next_upstream off;
            add_header X-Router-Upstream $upstream_addr always;
        }
    }
}
